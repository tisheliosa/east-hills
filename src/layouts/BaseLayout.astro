---
import '@fontsource-variable/archivo';
import '@fontsource-variable/inter';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, streetAddress } from '../data/site';
import { services } from '../data/services';

interface Props {
  title: string;
  description?: string;
  /** Set on the home page so structured data is only emitted once. */
  includeStructuredData?: boolean;
}

const { title, description = site.description, includeStructuredData = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://easthills.com.au').href;
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://easthills.com.au').href;

// LocalBusiness structured data, built from src/data/site.ts so the business
// details can never drift out of sync with what is rendered on the page.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  '@id': `${canonical}#business`,
  name: site.legalName,
  alternateName: site.name,
  description: site.description,
  url: Astro.site?.href ?? 'https://easthills.com.au/',
  telephone: site.phones.map((p) => p.tel),
  email: site.email,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress,
    addressLocality: site.address.suburb,
    addressRegion: site.address.state,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  areaServed: site.serviceArea.suburbs.map((s) => ({
    '@type': 'City',
    name: `${s}, NSW`,
  })),
  openingHoursSpecification: site.hours
    .filter((h) => h.opens !== null)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.days,
      opens: h.opens,
      closes: h.closes,
    })),
  identifier: {
    '@type': 'PropertyValue',
    name: 'ABN',
    value: site.abn,
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Installation and repair services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.name,
        description: s.body,
      },
    })),
  },
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0b0a" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="geo.region" content="AU-NSW" />
    <meta name="geo.placename" content={site.address.suburb} />

    {
      includeStructuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
      )
    }

    {/* Flags JS availability so scroll-reveal styles only hide content we can
        actually reveal. Inline and first so it runs before paint. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
