---
import ServiceCard from './ServiceCard.astro';
import { services, promises } from '../data/services';
import { primaryPhone } from '../data/site';
---

<section class="services section" id="services">
  <div class="shell">
    <div class="services__head">
      <div>
        <p class="eyebrow" data-reveal>What we do</p>
        <h2 class="services__title" data-reveal style="--reveal-delay:60ms">
          Six trades, one number to call.
        </h2>
      </div>
      <p class="lead" data-reveal style="--reveal-delay:120ms">
        Whether it is a hot water system that has stopped overnight or a full renovation that needs
        wiring, refrigeration, air conditioning and floors, it is the same team and the same standard.
      </p>
    </div>

    <div class="services__grid" data-reveal-group>
      {services.map((service, i) => <ServiceCard service={service} index={i} />)}
    </div>
  </div>

  <div class="promise on-ink">
    <div class="shell promise__inner">
      <ul class="promise__list">
        {
          promises.map((promise) => (
            <li>
              <span aria-hidden="true"></span>
              {promise}
            </li>
          ))
        }
      </ul>
      <a class="btn btn--copper" href={`tel:${primaryPhone.tel}`}>Get a free quote</a>
    </div>
  </div>
</section>

<style>
  .services {
    padding-bottom: 0;
  }

  .services__head {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  .services__title {
    font-size: var(--step-h2);
  }

  /* 1px gaps over a hairline background give clean dividers without doubled
     borders between cards. */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }

  .promise {
    margin-top: clamp(4rem, 9vh, 7rem);
  }

  .promise__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    padding-block: clamp(2rem, 4vh, 2.75rem);
  }

  .promise__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem clamp(1.25rem, 3vw, 2.5rem);
  }

  .promise__list li {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-size: var(--step-small);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--paper);
  }

  .promise__list span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--copper-lit);
    flex: none;
  }

  @media (max-width: 1040px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .services__head {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: start;
    }
  }

  @media (max-width: 640px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
