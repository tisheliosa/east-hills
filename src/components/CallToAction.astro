---
import { site } from '../data/site';
---

<section class="cta on-ink">
  <div class="shell">
    <p class="eyebrow" data-reveal>Get it sorted</p>
    <h2 class="cta__title" data-reveal style="--reveal-delay:60ms">
      Tell us what needs fixing.
    </h2>
    <p class="cta__lead lead" data-reveal style="--reveal-delay:120ms">
      Free quote, competitive rates, and a {site.warrantyMonths}-month warranty on the work. Pick up
      the phone and we will take it from there.
    </p>

    <div class="cta__numbers" data-reveal-group>
      {
        site.phones.map((phone) => (
          <a class="dial" href={`tel:${phone.tel}`} data-reveal>
            <span class="dial__label">{phone.label}</span>
            <span class="dial__number">{phone.display}</span>
          </a>
        ))
      }
    </div>

    <p class="cta__email" data-reveal>
      Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(4rem, 10vh, 7rem);
  }

  .cta__title {
    font-size: var(--step-h2);
    max-width: 20ch;
  }

  .cta__lead {
    margin-top: 1.25rem;
  }

  .cta__numbers {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin-top: clamp(2.5rem, 5vh, 3.5rem);
    background: var(--hairline-invert);
    border: 1px solid var(--hairline-invert);
  }

  .dial {
    flex: 1 1 16rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--ink);
    transition: background-color 0.3s var(--ease);
  }

  .dial:hover {
    background: var(--ink-soft);
  }

  .dial__label {
    font-size: var(--step-micro);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copper-lit);
  }

  .dial__number {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--paper);
  }

  .cta__email {
    margin-top: 1.75rem;
    font-size: var(--step-small);
    color: var(--steel-light);
  }

  .cta__email a {
    color: var(--paper);
    border-bottom: 1px solid var(--copper);
    padding-bottom: 1px;
  }

  .cta__email a:hover {
    color: var(--copper-lit);
  }
</style>
